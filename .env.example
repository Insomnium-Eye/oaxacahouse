# Copy to .env and fill values before running server
# Example for Gmail (use an app password if 2FA is enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_smtp_or_app_password
FROM_EMAIL=your.email@gmail.com
# Comma-separated recipient addresses (two emails):
TO_EMAILS=first.recipient@gmail.com,second.recipient@gmail.com
PORT=4000
